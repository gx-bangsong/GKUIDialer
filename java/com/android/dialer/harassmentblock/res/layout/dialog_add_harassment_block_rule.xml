<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/harassment_block_rule_type_title"
            android:textStyle="bold"
            android:textSize="14sp" />

        <!-- Rule type single-select chips: number segment / location / mark type -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rule_type_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/rule_type_chip_prefix"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/harassment_block_rule_type_number_prefix" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rule_type_chip_location"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/harassment_block_rule_type_location" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rule_type_chip_mark"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/harassment_block_rule_type_mark_type" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Mode (blacklist/whitelist) for this specific rule -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/harassment_block_mode_title"
            android:textStyle="bold"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/rule_mode_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/rule_mode_chip_blacklist"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="@string/harassment_block_rule_mode_blacklist" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rule_mode_chip_whitelist"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/harassment_block_rule_mode_whitelist" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Number-prefix / location input group -->
        <LinearLayout
            android:id="@+id/rule_value_input_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/rule_value_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/harassment_block_value_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rule_value_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick-input chips for common number segments, tapping fills the text field -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/harassment_block_common_prefixes_title"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/common_prefix_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleLine="false" />
        </LinearLayout>

        <!-- Mark-type multi-select chip group (国产 UI 风格多选 chips) -->
        <LinearLayout
            android:id="@+id/rule_mark_type_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/harassment_block_mark_types_title"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/mark_type_chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:singleLine="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
