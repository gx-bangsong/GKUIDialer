<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:background="?android:attr/selectableItemBackground">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/rule_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/rule_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
        android:textColor="?android:attr/textColorSecondary"
        android:maxLines="1"
        android:ellipsize="end" />
  </LinearLayout>

  <androidx.appcompat.widget.SwitchCompat
      android:id="@+id/rule_enabled_switch"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp" />

  <ImageButton
      android:id="@+id/rule_delete_button"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="4dp"
      android:background="?android:attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/block_rule_delete"
      android:src="@drawable/quantum_ic_delete_vd_theme_24"
      android:tint="?android:attr/textColorSecondary" />
</LinearLayout>
